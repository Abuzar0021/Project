# Copy to .env in this same folder, then fill in the values.
# docker compose reads this file automatically.

# The subdomain that points (DNS A record) at this VPS.
# Used by the standalone setup (docker-compose.yml).
CHECK_DOMAIN=check.omnistacksdigital.com

# A long random shared secret. Generate one with:
#   openssl rand -hex 32
# This must be identical to LANGUAGETOOL_SECRET in the Vercel project settings.
# Used by the standalone setup (docker-compose.yml).
CHECK_SHARED_SECRET=replace-with-a-long-random-string

# Only for the "behind an existing proxy" setup
# (docker-compose.behind-proxy.yml): the Docker network name of your existing
# proxy, so LanguageTool joins it and the proxy can reach it by container name.
# In that setup the domain and secret live in your existing proxy config
# (see Caddyfile.snippet), not here.
PROXY_NETWORK=omnistack_default
