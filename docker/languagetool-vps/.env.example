# Copy to .env in this same folder, then fill in the values.
# docker compose reads this file automatically.

# The subdomain that points (DNS A record) at this VPS.
CHECK_DOMAIN=check.omnistacksdigital.com

# A long random shared secret. Generate one with:
#   openssl rand -hex 32
# This must be identical to LANGUAGETOOL_SECRET in the Vercel project settings.
CHECK_SHARED_SECRET=replace-with-a-long-random-string
