# Copy to .env.local for development.

# Base URL of the LanguageTool server. The /api/check route forwards to
# `${LANGUAGETOOL_URL}/v2/check`. Never expose this to the browser directly.
# Local dev (Docker): http://localhost:8010
# Production (VPS behind Caddy): https://check.omnistacksdigital.com
LANGUAGETOOL_URL=http://localhost:8010

# Shared secret sent as the `X-Check-Secret` header when the /api/check route
# calls LANGUAGETOOL_URL. The VPS gateway (Caddy) requires it, so only this app
# can reach the checker. Server-side only; it is never sent to the browser.
# Leave empty for a local instance that needs no auth. Must match the value set
# in the VPS docker/.env (CHECK_SHARED_SECRET).
LANGUAGETOOL_SECRET=
